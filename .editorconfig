root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.cs]
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

# Unity-authored files: leave formatting to Unity, don't trim.
[*.{asset,meta,unity,prefab,mat,controller,anim}]
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
